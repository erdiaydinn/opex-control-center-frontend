DOCKOS_ENV=production
DOCKOS_PERSISTENCE=postgres
DATABASE_URL=
DOCKOS_TENANT_KEY=ys_tr
DOCKOS_DC_NAMES=Ankara DC,İstanbul Avrupa DC,İstanbul Anadolu DC,İzmir DC
DOCKOS_WORKERS=2
DOCKOS_SINGLE_WORKER=false
DOCKOS_GATEWAY_TRUST_MODE=hmac
DOCKOS_GATEWAY_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
DOCKOS_GATEWAY_MAX_SKEW_SECONDS=60
DOCKOS_TRUST_ROLE_HEADER=false
DOCKOS_OIDC_ISSUER=
DOCKOS_OIDC_AUDIENCE=
DOCKOS_OIDC_JWKS_URL=
DOCKOS_ADMIN_ROLES=dockos_admin,opex_admin
DOCKOS_PO_SOURCE=BIGQUERY
DOCKOS_BQ_PROJECT=fulfillment-dwh-production
DOCKOS_BIGQUERY_IDENTITY=
DOCKOS_DC_EMAILS=
DOCKOS_SMTP_HOST=
DOCKOS_SMTP_PORT=587
DOCKOS_SMTP_TLS=true
DOCKOS_SMTP_USER=
DOCKOS_SMTP_PASSWORD=
DOCKOS_SMTP_FROM=
DOCKOS_NOTIFICATION_AUTOMATION=true
DOCKOS_NOTIFICATION_INTERVAL_SECONDS=60
DOCKOS_NOTIFICATION_MAX_ATTEMPTS=8
DOCKOS_NOTIFICATION_RETRY_BASE_SECONDS=30
DOCKOS_SMTP_ACCEPTED=false
DOCKOS_BACKUP_RESTORE_ACCEPTED=false
OPEX_CORS_ORIGINS=https://YOUR_EAY_PLATFORM_DOMAIN
