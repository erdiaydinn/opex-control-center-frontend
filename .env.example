DOCKOS_NOTIFICATION_AUTOMATION=true
DOCKOS_NOTIFICATION_INTERVAL_SECONDS=60
DOCKOS_BACKUP_RETENTION_DAYS=30
OPEX_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
