# Runtime
OPEX_ENVIRONMENT=development
OPEX_LOG_LEVEL=INFO
OPEX_API_PORT=8000
OPEX_GATEWAY_PORT=8080
# Compatibility/runtime environment consumed by current converged services.
DOCKOS_ENV=development

# Database
# The migrator owns schema changes. The runtime role is non-superuser and subject to RLS.
OPEX_POSTGRES_DB=opex
OPEX_POSTGRES_MIGRATOR_PASSWORD=change-this-migration-password
OPEX_POSTGRES_RUNTIME_PASSWORD=change-this-runtime-password
OPEX_MIGRATION_DATABASE_URL=postgresql+asyncpg://opex_migrator:change-this-migration-password@postgres:5432/opex
OPEX_DATABASE_URL=postgresql+asyncpg://opex_runtime:change-this-runtime-password@postgres:5432/opex

# Redis
OPEX_REDIS_URL=redis://redis:6379/0
# Hiring anonymous offer/interview/upload capability abuse protection is mandatory in production.
# Prefer rediss:// with authenticated private Redis in production.
RECRUITMENT_PUBLIC_CAPABILITY_REDIS_URL=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0

# Reverse proxy -> backend service identity.
# The browser never supplies this value. nginx injects it after startup envsubst.
DOCKOS_GATEWAY_SECRET=change-this-long-random-gateway-secret

# Hiring production authorities
RECRUITMENT_CANDIDATE_UPLOAD_AUTHORITY_MODE=postgres
RECRUITMENT_EVIDENCE_STORAGE_MODE=s3-kms-envelope
RECRUITMENT_SCANNER_DATABASE_URL=
RECRUITMENT_SCANNER_DATABASE_ROLE=eay_candidate_scanner_runtime
RECRUITMENT_EVIDENCE_BUCKET=
RECRUITMENT_EVIDENCE_KMS_KEY_ID=
RECRUITMENT_EVIDENCE_OBJECT_LOCK_MODE=GOVERNANCE
RECRUITMENT_SCANNER_ACTIVE_KID=
# JSON map, e.g. {"2026-08":"arn:aws:kms:...:key/..."}
RECRUITMENT_SCANNER_KMS_VERIFY_KEYS={}

# Optional authorized official-document M2M. Leave the COMPLETE set blank until
# an institutional contract exists; partial configuration is rejected. Public
# turkiye.gov.tr human pages are not an API and must never be placed here.
RECRUITMENT_OFFICIAL_M2M_ENDPOINT=
RECRUITMENT_OFFICIAL_M2M_TOKEN_URL=
RECRUITMENT_OFFICIAL_M2M_CLIENT_ID=
RECRUITMENT_OFFICIAL_M2M_CLIENT_SECRET=
RECRUITMENT_OFFICIAL_M2M_MTLS_CERT=
RECRUITMENT_OFFICIAL_M2M_MTLS_KEY=
RECRUITMENT_OFFICIAL_M2M_ALLOWED_HOSTS=
RECRUITMENT_OFFICIAL_M2M_CONTRACT_ID=
RECRUITMENT_OFFICIAL_M2M_SIGNATURE_PROFILE=
RECRUITMENT_OFFICIAL_M2M_PROVIDER_PUBLIC_KEY_FILE=
RECRUITMENT_OFFICIAL_M2M_RESPONSE_PROFILE=

# Authentication
# development is allowed only outside production. Production must use oidc.
OPEX_AUTH_MODE=development
OPEX_OIDC_ISSUER=
OPEX_OIDC_AUDIENCE=opex-core-api
OPEX_OIDC_JWKS_URL=
OPEX_OIDC_EMPLOYEE_ID_CLAIM=employee_id
OPEX_OIDC_WAREHOUSE_SCOPE_CLAIM=warehouse_scope
OPEX_OIDC_REVOCATION_URL=
OPEX_OIDC_REVOCATION_TOKEN=
OPEX_ATTESTATION_GATEWAY_TOKEN=

# OPEX-owned internal assertion contract.
# Browser/provider access tokens must never use the pre-auth service audience.
OPEX_INTERNAL_ASSERTION_ISSUER=opex-identity-gateway
OPEX_INTERNAL_ASSERTION_AUDIENCE=opex-core-api
OPEX_INTERNAL_SERVICE_ASSERTION_AUDIENCE=opex-core-preauth
OPEX_INTERNAL_ASSERTION_LIFETIME_SECONDS=30

# Tenant resolution
OPEX_DEFAULT_TENANT_SLUG=local-demo
OPEX_ALLOWED_HOSTS=localhost,127.0.0.1,core-api,gateway
OPEX_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Local-first AI policy
OPEX_AI_PROVIDER=ollama
OPEX_OLLAMA_BASE_URL=http://ollama:11434
OPEX_OLLAMA_MODEL=qwen3:8b
OPEX_EXTERNAL_AI_ENABLED=false

# Never put real secrets in this file or commit a populated .env file.

# Automated PostgreSQL backups
OPEX_BACKUP_INTERVAL_HOURS=24
OPEX_BACKUP_RETENTION_DAYS=14
OPEX_BACKUP_TIMEZONE=Europe/Istanbul
OPEX_BACKUP_WARNING_AFTER_HOURS=26
OPEX_BACKUP_STALE_AFTER_HOURS=30

# Platform alert e-mail
OPEX_ALERT_EMAIL_ENABLED=false
OPEX_SMTP_HOST=smtp.example.com
OPEX_SMTP_PORT=587
OPEX_SMTP_USERNAME=alerts@example.com
OPEX_SMTP_PASSWORD=change-this-password
OPEX_SMTP_FROM=EAY OneOps <alerts@example.com>
OPEX_ALERT_RECIPIENTS=erdi@example.com
OPEX_SMTP_STARTTLS=true
OPEX_ALERT_COOLDOWN_HOURS=6
OPEX_ALERT_POLL_SECONDS=300

# Platform alert service authentication
# Development may use a temporary local token.
# Staging/production must use oidc; never commit real credentials here.
OPEX_PLATFORM_HEALTH_AUTH_MODE=development
OPEX_PLATFORM_HEALTH_TOKEN=

# OIDC client-credentials identity for platform-alerts
OPEX_ALERT_OIDC_TOKEN_URL=
OPEX_ALERT_OIDC_CLIENT_ID=
OPEX_ALERT_OIDC_CLIENT_SECRET=
OPEX_ALERT_OIDC_SCOPE=
OPEX_ALERT_OIDC_AUDIENCE=opex-core-api

# Production secret source files
# Paths only. Secret files themselves must stay outside the repository.
OPEX_RUNTIME_DATABASE_SECRET_FILE=
OPEX_MIGRATION_DATABASE_SECRET_FILE=

OPEX_POSTGRES_MIGRATOR_PASSWORD_SECRET_FILE=
OPEX_POSTGRES_RUNTIME_PASSWORD_SECRET_FILE=

# In-container secret-file inputs
OPEX_PLATFORM_HEALTH_TOKEN_FILE=
OPEX_ALERT_OIDC_CLIENT_SECRET_FILE=
OPEX_SMTP_PASSWORD_FILE=

# Production host/orchestrator secret source
OPEX_ALERT_OIDC_CLIENT_SECRET_SECRET_FILE=

# Production SMTP secret source path.
# Required only when docker-compose.production-email.yml is enabled.
OPEX_SMTP_PASSWORD_SECRET_FILE=

OPEX_POSTGRES_BACKUP_PASSWORD=
OPEX_POSTGRES_BACKUP_PASSWORD_FILE=
OPEX_POSTGRES_BACKUP_PASSWORD_SECRET_FILE=
