# Runtime
OPEX_ENVIRONMENT=development
OPEX_LOG_LEVEL=INFO
OPEX_API_PORT=8000
OPEX_GATEWAY_PORT=8080

# Database
# The migrator owns schema changes. The runtime role is non-superuser and subject to RLS.
OPEX_POSTGRES_DB=opex
OPEX_POSTGRES_MIGRATOR_PASSWORD=change-this-migration-password
OPEX_POSTGRES_RUNTIME_PASSWORD=change-this-runtime-password
OPEX_MIGRATION_DATABASE_URL=postgresql+asyncpg://opex_migrator:change-this-migration-password@postgres:5432/opex
OPEX_DATABASE_URL=postgresql+asyncpg://opex_runtime:change-this-runtime-password@postgres:5432/opex

# Redis
OPEX_REDIS_URL=redis://redis:6379/0

# Authentication
# development is allowed only outside production. Production must use oidc.
OPEX_AUTH_MODE=development
OPEX_OIDC_ISSUER=
OPEX_OIDC_AUDIENCE=opex-core-api
OPEX_OIDC_JWKS_URL=

# Tenant resolution
OPEX_DEFAULT_TENANT_SLUG=local-demo
OPEX_ALLOWED_HOSTS=localhost,127.0.0.1,core-api,gateway
OPEX_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Local-first AI policy
OPEX_AI_PROVIDER=ollama
OPEX_OLLAMA_BASE_URL=http://ollama:11434
OPEX_OLLAMA_MODEL=qwen3:8b
OPEX_EXTERNAL_AI_ENABLED=false

# Never put real secrets in this file or commit a populated .env file.
