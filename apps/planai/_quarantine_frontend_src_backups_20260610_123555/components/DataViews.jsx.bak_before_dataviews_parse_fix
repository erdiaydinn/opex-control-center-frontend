tton><button className="btn small ghost" onClick={()=>update(t.id,{status:'Done'})}>Tamamlandı</button><button className="btn small ghost" onClick={()=>update(t.id,{status:'Blocked'})}>Bloke</button></div></div>)}</div></div></div></div>;
}

