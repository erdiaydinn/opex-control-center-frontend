ssName="muted">Bu liste planın uygulanması için kapasite/fixture aksiyonu gerektirir.</p><table className="table"><thead><tr><th>SKU</th><th>Ürün</th><th>Storage</th><th>Neden</th><th>Aksiyon</th></tr></thead><tbody>{unplacedProducts.slice(0,80).map((p,i)=><tr key={`${p.sku}-${i}`}><td>{p.sku}</td><td>{p.name || p.product_name}</td><td>{p.storage}</td><td>{p.reason}</td><td>{p.suggested_action}</td></tr>)}</tbody></table></div>}</div>;
}

