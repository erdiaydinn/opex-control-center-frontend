export function ProductLibrary({ lang, products = [], unplacedProducts = [] }) {
  const source = [
    ...(Array.isArray(products) ? products : []),
    ...(Array.isArray(unplacedProducts) ? unplacedProducts : []),
  ];

  const seen = new Set();

  const libraryProducts = source
    .map((raw, idx) => {
      const sku = String(
        raw?.sku ||
        raw?.SKU ||
        raw?.platform_product_id ||
        raw?.product_id ||
        raw?.barcode ||
        raw?.Barcodes ||
        `ROW-${idx + 1}`
      ).trim();

      const storage = String(
        raw?.storage ||
        raw?.storage_type ||
        raw?.storage_type_clean ||
        raw?.storage_class ||
        raw?.catalog_storage_type ||
        "AMBIENT"
      ).toUpperCase();

      return {
        ...raw,
        sku,
        name: raw?.name || raw?.product_name || raw?.product_name_local || raw?.title || sku,
        brand: raw?.brand || raw?.supplier || raw?.manufacturer || "-",
        category:
          raw?.category ||
          raw?.category_l1 ||
          raw?.kategori_level_1 ||
          raw?.category_level_1 ||
          raw?.category_l2 ||
          raw?.kategori_level_2 ||
          raw?.merch_group ||
          "-",
        storage,
        sales:
          raw?.sales ??
          raw?.sales_qty_30d ??
          raw?.sales_qty_7d ??
          raw?.daily_sales ??
          raw?.order_frequency_30d ??
          raw?.["% Orders"] ??
          0,
        facing: raw?.facing ?? raw?.fronts ?? raw?.recommended_facing ?? 1,
        depth: raw?.depth ?? raw?.recommended_depth ?? raw?.depth_count ?? 1,
      };
    })
    .filter((p) => {
      const key = String(p.sku || "").trim();
      if (!key || seen.has(key)) return false;
      seen.add(key);
      return true;
    });

  return (
    <div className="page">
      <div className="section-eyebrow">DATA CENTER</div>
      <h1 style={{ fontSize: 42, margin: "8px 0" }}>{tt(lang, "library")}</h1>
      <p className="page-sub">
        SKU, barkod, ?r?n ad?, marka, kategori, storage type, ?l??, sat?? ve ?r?n g?rseli.
      </p>

      <div className="grid cols-4" style={{ marginBottom: 18 }}>
        <div className="card kpi">
          <div className="kpi-label">?r?n havuzu</div>
          <div className="kpi-value">{libraryProducts.length.toLocaleString("tr-TR")}</div>
          <div className="kpi-trend">Y?klenen + yerle?en</div>
        </div>
        <div className="card kpi">
          <div className="kpi-label">Yerle?en</div>
          <div className="kpi-value">{(products || []).length.toLocaleString("tr-TR")}</div>
          <div className="kpi-trend">Aktif plan</div>
        </div>
        <div className="card kpi">
          <div className="kpi-label">Aday / Atanmayan</div>
          <div className="kpi-value">{(unplacedProducts || []).length.toLocaleString("tr-TR")}</div>
          <div className="kpi-trend">Plan bekleyen havuz</div>
        </div>
        <div className="card kpi">
          <div className="kpi-label">K?t?phane kayna??</div>
          <div className="kpi-value">{libraryProducts.length ? "Aktif" : "Bo?"}</div>
          <div className="kpi-trend">State kontrol?</div>
        </div>
      </div>

      <div className="card pad">
        <input className="search" placeholder="SKU, barkod, ?r?n, marka ara..." />

        <h3>{tt(lang, "productImages")}</h3>
        <div className="product-card-grid">
          {libraryProducts.slice(0, 80).map((p) => (
            <div className="product-card" key={p.sku}>
              <ProductThumb product={p} />
              <div>
                <b>{p.name}</b>
                <br />
                <span className="muted">{p.sku} ? {p.brand}</span>
                <br />
                <span className={`badge ${storageTone(p.storage)}`}>{p.storage}</span>
              </div>
            </div>
          ))}
        </div>

        <table className="table" style={{ marginTop: 18 }}>
          <thead>
            <tr>
              <th>SKU</th>
              <th>?r?n</th>
              <th>Marka</th>
              <th>Kategori</th>
              <th>Storage</th>
              <th>Sat??</th>
              <th>Facing</th>
              <th>Depth</th>
            </tr>
          </thead>
          <tbody>
            {libraryProducts.map((p) => (
              <tr key={p.sku}>
                <td>{p.sku}</td>
                <td>{p.name}</td>
                <td>{p.brand}</td>
                <td>{p.category}</td>
                <td><span className={`badge ${storageTone(p.storage)}`}>{p.storage}</span></td>
                <td>{p.sales}</td>
                <td>{p.facing}</td>
                <td>{p.depth}</td>
              </tr>
            ))}
