PLONAGRAM_AUTH_REQUIRED=true
PLONAGRAM_ENV=development
PLONAGRAM_AUTH_SECRET=replace-with-a-long-random-secret
PLONAGRAM_BOOTSTRAP_PASSWORD=replace-with-a-12-character-password
PLONAGRAM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PLONAGRAM_TOKEN_TTL_SECONDS=28800
PLONAGRAM_MAX_UPLOAD_BYTES=26214400
