def generate_planogram(
    products: List[Dict[str, Any]],
    layout: Optional[Dict[str, Any]],
    mode: str = "HYBRID",
    brand_side_rules: Optional[Dict[str, str]] = None,
    scoring_config: Optional[Dict[str, float]] = None,
    allow_ai_dimensions: bool = True,
) -> Dict[str, Any]:
    raw_products = products or []
    plan = prepare_layout(layout or generate_default_layout())

    # PERFORMANCE GUARD
    MAX_PRODUCTS = 15000

    raw_products = sorted(
        raw_products,
        key=lambda x: (
            -num(get(x, ["sales_qty_7d", "sales_7d", "sales"], 0), 0),
            -num(get(x, ["percent_stops", "% Stops"], 0), 0),
        )
    )[:MAX_PRODUCTS]


    clean_products = []
    unplaced = []
    alerts = {
        "approval_fire_products": [],
        "dimension_missing": [],
        "storage_violations": [],
        "capacity_warnings": [],
        "low_coverage": [],
        "ai_dimension_low_confidence": [],
    }

    for raw in raw_products:
        p = enrich_product(raw, allow_ai_dimensions=allow_ai_dimensions)

        # Gercekten satilamaz stok/durum -> hard exclusion (IMHA/EXPIRED/DAMAGED/BLOCKED/PASSIVE/QUARANTINE)
        if is_unsellable(p):
            item = {
                "sku": sku(p),
                "product_name": product_name(p),
                "reason": "unsellable_stock_status",
                "suggested_action": "Imha/miadi gecmis/hasarli/bloke/pasif stok satis planogramina alinmaz.",
            }
            unplaced.append(item)
            alerts.setdefault("unsellable_products", []).append(item)
            continue

        # Approval/FIRE: HARD EXCLUSION DEGIL. Reserve/back-stock bilgisidir.
        # Pozitif stok sinyali (satis, on_hand, sellable) varsa yerlestirmeye devam eder;
        # approval/fire miktari depth/placed_units/coverage'i KISITLAR, urunu kaldirmaz.
        if is_approval(p):
            if has_positive_stock_signal(p):
                p["approval_area_stock"] = True
                p["reserve_stock_location"] = "APPROVAL_FIRE"
                p["capacity_strategy"] = "front_display_depth_limited"
                alerts.setdefault("approval_fire_products", []).append({
                    "sku": sku(p), "product_name": product_name(p),
                    "note": "Approval/FIRE reserve stok; on raf icin minimum/limitli derinlikle yerlestirildi.",
                })
                # devam et: normal yerlestirme akisina dusecek
            else:
                # Approval/FIRE ama hicbir pozitif stok sinyali yok -> yerlestirilemez
                item = {
                    "sku": sku(p),
                    "product_name": product_name(p),
                    "reason": "approval_fire_no_sellable_stock",
                    "suggested_action": "Approval/FIRE alaninda ve satilabilir stok sinyali yok; stok netlesince tekrar degerlendir.",
                }
                unplaced.append(item)
                alerts.setdefault("approval_fire_products", []).append(item)
                continue

        if not sku(p):
            unplaced.append({
                "sku": None,
                "product_name": product_name(p),
                "reason": "missing_sku",
            })
            continue

        if width(p) <= 0 or height(p) <= 0 or depth(p) <= 0:
            item = {
                "sku": sku(p),
                "product_name": product_name(p),
                "reason": "dimension_missing",
            }
            unplaced.append(item)
            alerts["dimension_missing"].append(item)
            continue

        if p.get("dimension_source") == "ai_estimated" and num(p.get("dimension_confidence"), 0) < 0.55:
            alerts["ai_dimension_low_confidence"].append({
                "sku": sku(p),
                "product_name": product_name(p),
                "confidence": p.get("dimension_confidence"),
                "reason": p.get("dimension_reason"),
            })

        clean_products.append(p)

    ranked = classify_products(clean_products)

    # --- MARKA BLOKLAMA ---
    # Sadece strateji/mode "BRAND" iceriyorsa rezervasyonlu yol calisir
    # (HYBRID_BRAND_SALES, BRAND_BLOCK, BRAND_FIRST...). Diger modlarda eski
    # HYBRID akisi (place_product_fast) aynen korunur.
    mode_key = str(mode or "").upper()
    brand_block_mode = "BRAND" in mode_key

    storage_rank = {"AMBIENT": 1, "CHILLED": 2, "FROZEN": 3, "PALLET": 4}

    if brand_block_mode:
        # storage once, sonra marka kesintisiz, marka icinde skor
        brand_strength: Dict[str, float] = {}
        for p in ranked:
            bb = brand(p)
            brand_strength[bb] = max(brand_strength.get(bb, 0.0), float(p.get("_score", 0) or 0))
        ranked = sorted(
            ranked,
            key=lambda p: (
                storage_rank.get(p.get("_storage"), 9),
                -brand_strength.get(brand(p), 0.0),
                brand(p),
                -float(p.get("_score", 0) or 0),
            ),
        )
    else:
        ranked = sorted(
            ranked,
            key=lambda p: (
                storage_rank.get(p.get("_storage"), 9),
                -float(p.get("_score", 0) or 0),
                brand(p),
            ),
        )

    shelf_pool, aisle_groups = build_shelf_index(plan)

    brand_block_meta: List[Dict[str, Any]] = []
    used_brand_block = False

    if brand_block_mode:
        # IZOLE REZERVASYON YOLU: marka bloklarini tek seferde ardisik raflara yaz.
        try:
            placed_list, bb_unplaced, brand_block_meta = place_brand_blocks(
                plan, ranked, shelf_pool, aisle_groups,
                scoring_config=scoring_config, brand_side_rules=brand_side_rules,
            )
            used_brand_block = True
            for it in bb_unplaced:
                unplaced.append({
                    **it,
                    "suggested_action": "Raf/dolap kapasitesini artir veya marka blok genisligini kontrol et.",
                })
            for placed in placed_list:
                if placed.get("coverage_days") is not None and placed.get("coverage_days") < 1:
                    alerts["low_coverage"].append({
                        "sku": placed["sku"], "product_name": placed["product_name"],
