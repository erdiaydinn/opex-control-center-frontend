                        "suggested_action": "Bu urun icin facing veya derinlik kapasitesi artirilmali.",
                    })
        except Exception as bb_exc:
            # Rezervasyon basarisiz -> eski yola dus, diagnostics'e acikca yaz.
            import traceback
            traceback.print_exc()
            alerts.setdefault("engine_notes", []).append({
                "note": "brand_block_reservation_failed",
                "detail": str(bb_exc),
            })
            used_brand_block = False
            # plan'i temiz yeniden kur (yarim yazilmis bloklari sil)
            plan = prepare_layout(layout or generate_default_layout())
            shelf_pool, aisle_groups = build_shelf_index(plan)

    if not used_brand_block:
        # VARSAYILAN HYBRID AKISI (degismedi): tek tek en iyi raf skoru.
        for p in ranked:
            ok, placed, reason = place_product_fast(
                plan, p, shelf_pool, aisle_groups,
                scoring_config=scoring_config, brand_side_rules=brand_side_rules,
            )
            if not ok:
                unplaced.append({
                    "sku": sku(p),
                    "product_name": product_name(p),
                    "brand": brand(p),
                    "category_l1": category_l1(p),
                    "category_l2": category_l2(p),
                    "storage_type": p.get("_storage"),
                    "reason": f"no_capacity_or_constraint_for_{p.get('_storage')}",
                    "constraint_reason": reason,
                    "suggested_action": "Raf/dolap kapasitesini artÄ±r, facing azalt, storage alanÄ±nÄ± kontrol et veya Ã¼rÃ¼n Ã¶lÃ§Ã¼sÃ¼nÃ¼ doÄŸrula.",
                })
            else:
                if placed and placed.get("coverage_days") is not None and placed.get("coverage_days") < 1:
                    alerts["low_coverage"].append({
                        "sku": placed["sku"],
                        "product_name": placed["product_name"],
                        "coverage_days": placed["coverage_days"],
                        "suggested_action": "Bu Ã¼rÃ¼n iÃ§in facing veya derinlik kapasitesi artÄ±rÄ±lmalÄ±.",
                    })

    summary = summarize(plan, len(raw_products), unplaced)
    alerts["capacity_warnings"] = summary["capacity_warnings"]

    diagnostics = validate_planogram(plan)
    if isinstance(diagnostics, dict):
        diagnostics["brand_block_mode"] = brand_block_mode
        diagnostics["brand_block_used"] = used_brand_block
        if brand_block_mode and not used_brand_block:
            diagnostics["brand_block_reservation_failed"] = True

    return {
        "summary": summary,
        "planogram": plan,
        "unplaced": unplaced,
        "unplaced_products": unplaced,
        "alerts": alerts,
        "diagnostics": diagnostics,
        "brand_blocks": brand_block_meta,
        "insights": {
