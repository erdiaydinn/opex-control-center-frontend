def _test_brand_blocks() -> bool:
    layout = generate_default_layout()
    for a in layout.get("aisles", []):
        for m in a.get("modules", []):
            for sh in m.get("shelves", []):
                sh["shelf_width_cm"] = 120  # bloklarin rahat sigmasi icin

    brand_sales = {"CocaCola": [310, 200, 150, 40], "Ulker": [300, 280, 90, 70, 60], "Eti": [290, 250, 80, 55]}
    products, i = [], 0
    for b, sl in brand_sales.items():
        for s in sl:
            i += 1
            products.append({
                "sku": f"S{i}", "brand": b, "product_name": f"{b} {i}",
                "storage_type": "AMBIENT", "width_cm": 8, "height_cm": 15, "depth_cm": 8,
                "case_pack_qty": 12, "sales_qty_7d": s,
                "category_l1": "Atistirmalik", "category_l2": "Genel",
            })

    res = generate_planogram(products=products, layout=layout, mode="HYBRID_BRAND_SALES")

    seq = [it["brand"]
           for a in res["planogram"]["aisles"]
           for m in a["modules"]
           for sh in m["shelves"]
           for it in sh["products"]]
    blocks = []
    for b in seq:
        if not blocks or blocks[-1] != b:
            blocks.append(b)

    contiguous = len(blocks) == len(set(blocks))
    placed = sum(len(sh.get("products", []))
                 for a in res["planogram"]["aisles"]
                 for m in a["modules"]
                 for sh in m["shelves"])

    # case_pack korunumu (#6): her yerlesen urunun total_capacity_units case_pack kati
    cp_ok = True
    for a in res["planogram"]["aisles"]:
        for m in a["modules"]:
            for sh in m["shelves"]:
                for it in sh["products"]:
                    cp = int(it.get("case_pack_qty") or 1)
                    if cp > 1 and int(it.get("total_capacity_units") or 0) % cp != 0:
                        cp_ok = False

    print(f"[brand-block test] yerlesen={placed}/{len(products)} bloklar={blocks}")
    print(f"[brand-block test] kesintisiz={contiguous} case_pack_korundu={cp_ok}")
    assert contiguous, "FAIL: marka bloklari kesintisiz degil"
    assert cp_ok, "FAIL: case_pack rounding bozuldu"
    print("[brand-block test] GECTI")
    return True


def _test_approval_reserve_stock() -> bool:
    """Approval/FIRE hard exclusion DEGIL: satilabilir stok varsa yerlesir,
    front stok placed_units'i cap'ler, sadece unsellable hard exclude (#1-#5)."""
    layout = generate_default_layout()
    for a in layout.get("aisles", []):
        for m in a.get("modules", []):
            for sh in m.get("shelves", []):
                sh["shelf_width_cm"] = 120
                sh["shelf_depth_cm"] = 50

    # 1) Approval + satis -> yerlesir, approval_area_fire_stock reason YOK
    appr = [{"sku": "BUZ1", "product_name": "Buzdagi Water", "brand": "Buzdagi",
             "storage_type": "AMBIENT", "current_location": "APPROVAL-A1",
             "width_cm": 7, "depth_cm": 7, "height_cm": 20, "case_pack_qty": 12,
             "sales_qty_7d": 80, "on_hand_qty": 50, "category_l1": "Beverage", "category_l2": "Water"}]
    r = generate_planogram(products=appr, layout=layout, mode="HYBRID")
    placed = [it for a in r["planogram"]["aisles"] for m in a["modules"]
              for sh in m["shelves"] for it in sh["products"]]
    assert len(placed) == 1, "Approval+satis urun yerlesemedi"
    assert placed[0].get("approval_area_stock") is True
    assert placed[0].get("reserve_stock_location") == "APPROVAL_FIRE"
    assert not any(u.get("reason") == "approval_area_fire_stock" for u in r.get("unplaced_products", []))

    # 2) Unsellable (IMHA) -> hard exclude
    unsell = [{"sku": "IMHA1", "product_name": "Bozuk", "brand": "X", "storage_type": "AMBIENT",
               "current_location": "IMHA-DEPO", "width_cm": 8, "depth_cm": 8, "height_cm": 15,
               "case_pack_qty": 6, "sales_qty_7d": 10}]
    r2 = generate_planogram(products=unsell, layout=layout, mode="HYBRID")
    assert any(u.get("reason") == "unsellable_stock_status" for u in r2.get("unplaced_products", []))

    # 3) Approval + sinirli front stok -> placed_units kucuk
    appr_front = [{"sku": "COLA1", "product_name": "Coca-Cola 1L", "brand": "CocaCola",
                   "storage_type": "AMBIENT", "current_location": "FIRE-B2",
                   "width_cm": 8, "depth_cm": 8, "height_cm": 30, "case_pack_qty": 6,
                   "sales_qty_7d": 200, "on_hand_qty": 100, "available_qty": 6}]
    r3 = generate_planogram(products=appr_front, layout=layout, mode="HYBRID")
    p3 = [it for a in r3["planogram"]["aisles"] for m in a["modules"]
          for sh in m["shelves"] for it in sh["products"]]
    assert p3 and p3[0].get("placed_units") <= 12 and p3[0].get("approval_depth_limited") is True

    print("[approval test] Approval/FIRE reserve-stock yerlesim, unsellable exclude, front-stok cap: GECTI")
    return True


