def dimension_fit(p: Dict[str, Any], shelf: Dict[str, Any]) -> bool:
    if height(p) > num(shelf.get("shelf_height_cm"), 35):
        return False
    if depth(p) > num(shelf.get("shelf_depth_cm"), 50):
        return False
    return True


def weight_fit(p: Dict[str, Any], shelf: Dict[str, Any]) -> bool:
    current = num(shelf.get("used_weight_kg"), 0)
    add = weight(p) * preferred_facing(p, shelf)
    limit = num(shelf.get("max_weight_kg"), 45)
    return current + add <= limit


def capacity_fit(p: Dict[str, Any], shelf: Dict[str, Any]) -> bool:
    # Ideal satis facing'i HARD reject DEGIL. En az bir tam koli fiziksel olarak
    # sigiyorsa urun yerlesebilir (feasible solver karar verir).
    return solve_feasible_facing(p, shelf)["fits"]



def product_placement_confidence(p: Dict[str, Any], module: Optional[Dict[str, Any]] = None, shelf: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    score = 0
    reasons = []

    raw_storage = storage_from_raw(p)
    if raw_storage:
        score += 25
        reasons.append(f"storage_raw net: {clean_text(get(p, ['storage_raw', 'storageRaw'], ''))}")
    elif key(get(p, ["storage_type", "Storage Type"], "")) in ["AMBIENT", "CHILLED", "FROZEN", "PALLET"]:
        score += 18
        reasons.append("storage_type mevcut")
    else:
        score += 8
        reasons.append("storage bilgisi kategori/isim fallback ile Ã§Ã¶zÃ¼ldÃ¼")

    dim_source = clean_text(p.get("dimension_source"))
    dim_conf = num(p.get("dimension_confidence"), 0)
    if dim_source in ["file", "master", "approved_user_override"] or dim_conf >= 0.9:
        score += 20
        reasons.append("Ã¼rÃ¼n Ã¶lÃ§Ã¼leri gÃ¼venilir")
    elif dim_source == "ai_estimated":
        score += max(5, int(20 * min(dim_conf, 1)))
        reasons.append("Ã¼rÃ¼n Ã¶lÃ§Ã¼sÃ¼ AI tahmini")
    else:
        score += 4
        reasons.append("Ã¼rÃ¼n Ã¶lÃ§Ã¼sÃ¼ dÃ¼ÅŸÃ¼k gÃ¼venli")

    if case_pack(p) > 1:
        score += 15
        reasons.append("case_pack_qty mevcut")
    else:
        score += 5
        reasons.append("case_pack_qty eksik veya 1")

    if module is not None and shelf is not None and fixture_compatible(p, module, shelf):
        score += 15
        reasons.append("fixture uyumu var")
    elif module is not None and shelf is not None:
        score += 0
        reasons.append("fixture uyumu riskli")
    else:
        score += 8
        reasons.append("fixture uyumu henÃ¼z Ã¶lÃ§Ã¼lmedi")

    if shelf is not None and dimension_fit(p, shelf):
        score += 10
        reasons.append("raf Ã¶lÃ§Ã¼sÃ¼ne sÄ±ÄŸÄ±yor")
    elif shelf is not None:
        reasons.append("raf Ã¶lÃ§Ã¼sÃ¼ uyumsuz")
    else:
        score += 5

    if shelf is not None and capacity_fit(p, shelf):
        score += 5
        reasons.append("raf kapasitesine sÄ±ÄŸÄ±yor")

    if p.get("_abc") or get(p, ["abc", "abc_class", "ABC"], ""):
        score += 5
        reasons.append("ABC verisi mevcut")

    warning = clean_text(p.get("data_quality_flags"))
    if warning:
        score -= 10
        reasons.append(f"data warning: {warning}")

    score = max(0, min(100, int(round(score))))
    level = "HIGH" if score >= 85 else "MEDIUM" if score >= 65 else "LOW"
    return {"score": score, "level": level, "reasons": reasons}



def can_place(
    p: Dict[str, Any],
    aisle: Dict[str, Any],
    module: Dict[str, Any],
    shelf: Dict[str, Any],
    aisle_groups: Optional[set] = None,
) -> Tuple[bool, str]:
    if storage_score(p, aisle, module, shelf) < -1000:
        return False, "storage_not_fit"

    if not module_rule_matches(p, module):
        return False, "module_rule_not_match"

    shelf_rule = shelf.get("assignment_rule")
    if shelf_rule and not module_rule_matches(p, {"assignment_rule": shelf_rule}):
        return False, "shelf_rule_not_match"

    if not merch_compatible(p, aisle, aisle_groups):
        return False, "merch_not_compatible"

    if not dimension_fit(p, shelf):
        return False, "dimension_not_fit"

    if not capacity_fit(p, shelf):
        return False, "capacity_not_fit"

    if not weight_fit(p, shelf):
        return False, "weight_not_fit"

    return True, "ok"


