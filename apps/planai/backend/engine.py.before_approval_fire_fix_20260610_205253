def facing_count(p: Dict[str, Any]) -> int:
    s = sales_7d(p)
    stops = percent_stops(p)
    tier = p.get("_tier")

    if tier == "HOT" or s >= 140 or stops >= 10:
        return 5
    if tier == "FAST" or s >= 80 or stops >= 6:
        return 3
    if tier == "MID" or s >= 30:
        return 2
    return 1


def depth_units(p: Dict[str, Any], shelf: Dict[str, Any]) -> int:
    return max(1, int(num(shelf.get("shelf_depth_cm"), 50) // max(depth(p), 1)))


def total_capacity_units(p: Dict[str, Any], shelf: Dict[str, Any], facing: int) -> int:
    return depth_units(p, shelf) * facing


def coverage_days(p: Dict[str, Any], shelf: Dict[str, Any], facing: int) -> Optional[float]:
    s = sales_7d(p)
    if s <= 0:
        return None
    return round((total_capacity_units(p, shelf, facing) / s) * 7, 1)



def solve_feasible_facing(p: Dict[str, Any], shelf: Dict[str, Any]) -> Dict[str, Any]:
    """Uygulanabilir, case-pack-uyumlu facing/units cozucusu.

    Ideal satis talebi HARD kapasite sarti DEGILDIR. Rafa fiziksel olarak ne
    sigiyorsa, ona en yakin TAM KOLI kati yerlestirilir. case_pack_qty hard
    operasyonel kural olarak korunur (kirik koli yok).

    Doner: facing_count, depth_units, placed_units, used_width_cm,
    feasible_case_units, max_physical_units, ideal_case_pack_units,
    raw_recommended_units, capacity_compromised, refill_risk,
    case_pack_min_fit, capacity_warning, fits (yerlesebilir mi).
    """
    cp = max(1, int(round(case_pack(p))))
    d_units = depth_units(p, shelf)
    eff_width = depth(p) if p.get("is_rotated") else width(p)
    eff_width = max(eff_width, 0.1)
    slot_width = eff_width * 1.1  # raf payi

    shelf_total = num(shelf.get("shelf_width_cm"), 100)
    used = num(shelf.get("used_width_cm", shelf.get("used", 0)), 0)
    remaining = shelf_total - used

    # 1) ham satis hedefi -> case-pack'e yukari yuvarla (14 hedef, cp=12 -> 24)
    weekly = sales_7d(p)
    if weekly > 0:
        raw_recommended_units = max(int(math.ceil(weekly)), cp)
    else:
        raw_recommended_units = cp
    ideal_case_pack_units = case_pack_rounded_units(raw_recommended_units, cp)

    # 2) fiziksel olarak sigan max facing ve units
    max_feasible_facing = int(remaining // slot_width)
    max_physical_units = max_feasible_facing * d_units

    # 6) en az bir tam koli bile sigmiyorsa reddet
    if max_feasible_facing < 1 or max_physical_units < cp:
        return {
            "fits": False,
            "reason": "case_pack_min_not_fit",
            "depth_units": d_units,
            "max_feasible_facing": max_feasible_facing,
            "max_physical_units": max_physical_units,
            "ideal_case_pack_units": ideal_case_pack_units,
            "raw_recommended_units": raw_recommended_units,
            "case_pack_min_fit": False,
        }

    # 5) ideal > fiziksel ise, sigan en buyuk TAM KOLI katini yerlestir
    if ideal_case_pack_units > max_physical_units:
        feasible_case_units = (max_physical_units // cp) * cp
        capacity_compromised = True
        capacity_warning = "ideal_sales_coverage_not_fit"
    else:
        feasible_case_units = ideal_case_pack_units
        capacity_compromised = False
        capacity_warning = None

    placed_units = feasible_case_units
    facing_count_val = int(math.ceil(placed_units / max(1, d_units)))
    # guvenlik: facing fiziksel siniri asmasin
    facing_count_val = max(1, min(facing_count_val, max_feasible_facing))

    # --- APPROVAL/FIRE & on-stok kapasite kisiti ---
    # Approval/FIRE reserve stogu depth'i SISIRMEZ. Satilabilir/on raf stogu
    # biliniyorsa placed_units onunla cap'lenir; bilinmiyorsa minimum display derinligi.
    approval_depth_limited = False
    planned_depth_units = d_units
    front_qty = front_stock_qty(p)
    is_appr = bool(p.get("approval_area_stock"))

    cap_units = None
    if front_qty is not None:
        # Satilabilir on stok biliniyor: bununla cap'le (reserve haric).
        cap_units = front_qty
    elif is_appr:
        # Approval/FIRE ama on/reserve ayrimi bilinmiyor: minimum display derinligi.
        # on_hand reserve'i icerebilir, o yuzden on_hand'le sismeyiz; min 1 koli/1 facing.
        cap_units = cp  # en az bir tam koli display

    if cap_units is not None and cap_units < placed_units:
        # tam koli kati halinde cap uygula (kirik koli yok); en az 1 koli
        capped = max(cp, (int(cap_units) // cp) * cp)
        if capped < placed_units:
            placed_units = capped
            facing_count_val = max(1, int(math.ceil(placed_units / max(1, d_units))))
            facing_count_val = min(facing_count_val, max_feasible_facing)
            planned_depth_units = max(1, int(math.ceil(placed_units / max(1, facing_count_val))))
            approval_depth_limited = True
            if not capacity_warning:
                capacity_warning = "approval_front_stock_depth_limited"

    placed_used_width = round(eff_width * facing_count_val * 1.1, 1)

    # refill riski: kapasite ideale gore ne kadar dustu
    if approval_depth_limited:
        refill_risk = "HIGH"
    elif capacity_compromised:
        ratio = placed_units / max(1, ideal_case_pack_units)
        refill_risk = "HIGH" if ratio < 0.5 else "MEDIUM"
    else:
        refill_risk = "LOW"

    return {
        "fits": True,
        "reason": "ok",
        "depth_units": d_units,
        "planned_depth_units": planned_depth_units,
        "facing_count": facing_count_val,
        "placed_units": placed_units,
        "feasible_case_units": feasible_case_units,
        "max_feasible_facing": max_feasible_facing,
        "max_physical_units": max_physical_units,
        "ideal_case_pack_units": ideal_case_pack_units,
        "raw_recommended_units": raw_recommended_units,
        "used_width_cm": placed_used_width,
        "capacity_compromised": capacity_compromised or approval_depth_limited,
        "refill_risk": refill_risk,
        "case_pack_min_fit": True,
        "capacity_warning": capacity_warning,
        "approval_depth_limited": approval_depth_limited,
    }


def preferred_facing(p: Dict[str, Any], shelf: Dict[str, Any]) -> int:
    # Geriye uyumluluk: artik feasible solver'in facing'ini kullanir.
    sol = solve_feasible_facing(p, shelf)
    if sol["fits"]:
        return sol["facing_count"]
    return max(1, sol.get("max_feasible_facing", 1))


def used_width(p: Dict[str, Any], shelf: Dict[str, Any]) -> float:
    sol = solve_feasible_facing(p, shelf)
    if sol["fits"]:
        return sol["used_width_cm"]
    # sigmiyorsa tek facing genisligi (capacity_fit zaten reddedecek)
    eff_width = depth(p) if p.get("is_rotated") else width(p)
    return round(max(eff_width, 0.1) * 1.1, 1)


