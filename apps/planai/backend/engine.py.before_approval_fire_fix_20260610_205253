def build_shelf_index(plan: Dict[str, Any]) -> Tuple[Dict[str, List[Dict[str, Any]]], Dict[str, set]]:
    shelf_pool = {"AMBIENT": [], "CHILLED": [], "FROZEN": [], "PALLET": []}
    aisle_groups = {}

    for aisle in plan.get("aisles", []):
        aid = clean_text(aisle.get("aisle_id"))
        aisle_groups[aid] = set()

        for module in aisle.get("modules", []):
            for shelf in module.get("shelves", []):
                storage = shelf_storage(shelf)
                if storage not in shelf_pool:
                    shelf_pool[storage] = []

                shelf_pool[storage].append({
                    "aisle": aisle,
                    "module": module,
                    "shelf": shelf,
                    "route": route_score(aisle, module),
                })

    return shelf_pool, aisle_groups


def fixture_kind_label(storage: Optional[str]) -> str:
    return {"AMBIENT": "SHELF", "CHILLED": "FRIDGE", "FROZEN": "FREEZER", "PALLET": "SHELF"}.get(
        key(storage or "AMBIENT"), "SHELF"
    )


def _build_placed_record(p, aisle, module, shelf, score=0.0, extra=None):
    """Bir urunun raf kaydini olusturur (place_product_fast ve brand-block ortak)."""
    sol = solve_feasible_facing(p, shelf)
    if not sol["fits"]:
        return None, 0.0, 0
    f = sol["facing_count"]
    u = sol["used_width_cm"]
    raw_cap_units = sol["placed_units"]
    rounded_cap_units = sol["placed_units"]   # fiziksel kapasiteyi ASMAZ
    cap_units = sol["placed_units"]
    cov = round((sol["placed_units"] / sales_7d(p)) * 7, 1) if sales_7d(p) > 0 else None
    confidence = product_placement_confidence(p, module, shelf)

    placed = {
        "sku": sku(p),
        "barcode": clean_text(get(p, ["barcode", "product_barcodes"], "")),
        "product_name": product_name(p),
        "brand": brand(p),
        "brand_name": brand(p),
        "category_l1": category_l1(p),
        "category_l2": category_l2(p),
        "frontend_category_local": category_l1(p),
        "frontend_subcategory_local": category_l2(p),
        "image_url": image_url(p),
        "storage_type": p.get("_storage"),
        "fixture_kind": fixture_kind_label(p.get("_storage")),
        "merch_group": p.get("_merch_group"),
        "abc_class": p.get("_abc"),
        "tier": p.get("_tier"),
        "front_tier": p.get("_tier"),
        "sales_qty_7d": sales_7d(p),
        "percent_stops": percent_stops(p),
        "on_hand_qty": on_hand(p),
        "width_cm": width(p),
        "height_cm": height(p),
        "depth_cm": depth(p),
        "weight_kg": weight(p),
        "case_pack_qty": case_pack(p),
        "facing": f,
        "facing_count": f,
        "used_width_cm": round(u, 1),
        "depth_units": sol["depth_units"],
        "planned_depth_units": sol.get("planned_depth_units", sol["depth_units"]),
        "raw_recommended_units": sol["raw_recommended_units"],
        "ideal_case_pack_units": sol["ideal_case_pack_units"],
        "max_physical_units": sol["max_physical_units"],
        "placed_units": sol["placed_units"],
        "feasible_case_units": sol["feasible_case_units"],
        "raw_capacity_units": raw_cap_units,
        "case_pack_rounded_units": rounded_cap_units,
        "case_pack_rounding_applied": sol["placed_units"] != sol["raw_recommended_units"],
        "total_capacity_units": cap_units,
        "capacity_compromised": sol["capacity_compromised"],
        "refill_risk": sol["refill_risk"],
        "case_pack_min_fit": sol["case_pack_min_fit"],
        "capacity_warning": sol["capacity_warning"],
        # --- approval / reserve back-stock ---
        "approval_area_stock": bool(p.get("approval_area_stock", False)),
        "reserve_stock_location": p.get("reserve_stock_location"),
        "capacity_strategy": p.get("capacity_strategy"),
        "front_stock_qty": front_stock_qty(p),
        "reserve_stock_qty": reserve_stock_qty(p),
        "approval_depth_limited": sol.get("approval_depth_limited", False),
        "placement_confidence": confidence["score"],
        "confidence_level": confidence["level"],
        "confidence_reasons": confidence["reasons"],
        "print_visible_confidence": False,
        "coverage_days": cov,
        "dimension_source": p.get("dimension_source"),
        "dimension_confidence": p.get("dimension_confidence"),
        "dimension_reason": p.get("dimension_reason"),
        "aisle": aisle.get("aisle_id"),
        "aisle_id": aisle.get("aisle_id"),
        "module_id": module.get("module_id"),
        "shelf_no": shelf.get("shelf_no"),
        "position_order": len(shelf.get("products", [])) + 1,
        "placement_score": round(score, 1),
        # brand-block alanlari (fast yolda None/bos kalir)
        "brand_block_id": None,
        "brand_block_name": None,
        "brand_block_sequence": None,
        "brand_block_split": False,
        "brand_block_warning": None,
        "placement_reason": "score_based",
    }
    if extra:
        placed.update(extra)
    return placed, u, f


def _commit_placed(placed, p, aisle, module, shelf, u, f, aisle_groups):
    """Kaydi rafa yazar ve raf/koridor sayaclarini gunceller."""
    shelf.setdefault("products", []).append(placed)
    shelf["used_width_cm"] = round(num(shelf.get("used_width_cm"), 0) + u, 1)
    shelf["used"] = shelf["used_width_cm"]
    shelf["used_weight_kg"] = round(num(shelf.get("used_weight_kg"), 0) + weight(p) * f, 2)
    aisle_groups.setdefault(clean_text(aisle.get("aisle_id")), set()).add(p.get("_merch_group"))


def _shelf_has_room(p, shelf) -> bool:
    remaining = num(shelf.get("shelf_width_cm"), 100) - num(shelf.get("used_width_cm"), 0)
    return remaining >= width(p)


def place_brand_blocks(
    plan: Dict[str, Any],
    products: List[Dict[str, Any]],
    shelf_pool: Dict[str, List[Dict[str, Any]]],
    aisle_groups: Dict[str, set],
    scoring_config: Optional[Dict[str, float]] = None,
    brand_side_rules: Optional[Dict[str, str]] = None,
) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]], List[Dict[str, Any]]]:
    """Marka-blok rezervasyonlu yerlestirici (sadece BRAND modu).

    1) Urunler storage_type'a gore ayrilir.
    2) Marka gruplari olusur, marka gucune gore (max skor) siralanir.
    3) Her markaya AYNI storage havuzunda ardisik raf/modul bloku tahsis edilir.
    4) Marka urunleri o bloka SIRAYLA yazilir (tek tek skor secimi YOK).
    5) Blok sigmazsa: ayni modulde sonraki raf -> bitisik modul -> split warning.

    Donen: (placed_list, unplaced_list, block_meta_list). Hata olursa exception
    firlatir; cagiran place_product_fast fallback'ine duser.
    """
    placed_all: List[Dict[str, Any]] = []
    unplaced_all: List[Dict[str, Any]] = []
    block_meta: List[Dict[str, Any]] = []

    def _shelf_sort_key(item):
        return (
            clean_text(item["aisle"].get("aisle_id")),
            num(item["module"].get("module_id"), 0),
            num(item["shelf"].get("shelf_no"), 0),
            item.get("route", 9999),
        )

    by_storage: Dict[str, List[Dict[str, Any]]] = {}
    for p in products:
        st = p.get("_storage") or storage_type(p)
        by_storage.setdefault(st, []).append(p)

    block_counter = 0

    for storage, sp_products in by_storage.items():
        shelves = sorted(shelf_pool.get(storage, []), key=_shelf_sort_key)
        if not shelves:
            for p in sp_products:
                unplaced_all.append({
                    "sku": sku(p), "product_name": product_name(p), "brand": brand(p),
                    "storage_type": storage, "reason": f"no_shelf_for_{storage}",
                    "placement_reason": "no_fixture_for_storage",
                })
            continue

        brand_groups: Dict[str, List[Dict[str, Any]]] = {}
        for p in sp_products:
            brand_groups.setdefault(brand(p), []).append(p)
        ordered_brands = sorted(
            brand_groups.keys(),
            key=lambda b: -max(float(x.get("_score", 0) or 0) for x in brand_groups[b]),
        )

        shelf_cursor = 0  # bu storage havuzunda dolasilan raf indeksi

        for b in ordered_brands:
            block_counter += 1
            block_id = f"BB-{storage}-{block_counter}"
            group = sorted(brand_groups[b], key=lambda x: -float(x.get("_score", 0) or 0))
            seq = 0
            block_split = False
            first_module_key = None

            for p in group:
                placed_ok = False
                for idx in range(shelf_cursor, len(shelves)):
                    item = shelves[idx]
                    aisle, module, shelf = item["aisle"], item["module"], item["shelf"]
                    if not _shelf_has_room(p, shelf):
                        continue
                    aid = clean_text(aisle.get("aisle_id"))
                    ok, reason = can_place(p, aisle, module, shelf, aisle_groups.get(aid, set()))
                    if not ok:
                        continue

                    mod_key = (aid, module.get("module_id"))
                    if first_module_key is None:
                        first_module_key = mod_key
                    elif mod_key != first_module_key:
                        block_split = True

                    seq += 1
                    placed, u, f = _build_placed_record(
                        p, aisle, module, shelf,
                        score=placement_score(p, aisle, module, shelf, scoring_config, brand_side_rules),
                        extra={
                            "brand_block_id": block_id,
                            "brand_block_name": b,
                            "brand_block_sequence": seq,
                            "brand_block_split": block_split,
                            "placement_reason": "brand_block_reserved",
                        },
                    )
                    _commit_placed(placed, p, aisle, module, shelf, u, f, aisle_groups)
                    placed_all.append(placed)
                    placed_ok = True
                    shelf_cursor = idx  # blok ayni/komsu raflarda devam etsin
                    break

                if not placed_ok:
                    unplaced_all.append({
                        "sku": sku(p), "product_name": product_name(p), "brand": brand(p),
                        "storage_type": storage, "reason": f"brand_block_no_capacity_{storage}",
                        "brand_block_id": block_id, "brand_block_name": b,
                        "placement_reason": "brand_block_overflow",
                    })

            # blok bittikten sonra: mevcut raf neredeyse doluysa sonraki rafa gec
            if shelf_cursor < len(shelves):
                cur_shelf = shelves[shelf_cursor]["shelf"]
                if num(cur_shelf.get("shelf_width_cm"), 100) - num(cur_shelf.get("used_width_cm"), 0) < 12:
                    shelf_cursor += 1

            warning = "split_brand_block" if block_split else None
            block_meta.append({
                "brand_block_id": block_id,
                "brand_block_name": b,
                "storage_type": storage,
                "brand_block_split": block_split,
                "brand_block_warning": warning,
                "items": seq,
            })
            if warning:
                for rec in placed_all:
                    if rec.get("brand_block_id") == block_id:
                        rec["brand_block_warning"] = warning
                        rec["brand_block_split"] = True

    return placed_all, unplaced_all, block_meta


def place_product_fast(
    plan: Dict[str, Any],
    p: Dict[str, Any],
    shelf_pool: Dict[str, List[Dict[str, Any]]],
    aisle_groups: Dict[str, set],
    scoring_config: Optional[Dict[str, float]] = None,
    brand_side_rules: Optional[Dict[str, str]] = None,
) -> Tuple[bool, Optional[Dict[str, Any]], str]:

    storage = p.get("_storage") or storage_type(p)

    candidates = shelf_pool.get(storage, [])

    candidates = sorted(
        candidates,
        key=lambda x: (
            num(x["shelf"].get("used_width_cm"), 0),
            x.get("route", 9999),
        )
    )[:40]

    best = None
    best_score = -10**18
    last_reason = "no_candidate"

    for item in candidates:
        aisle, module, shelf = item["aisle"], item["module"], item["shelf"]

        remaining_width = num(shelf.get("shelf_width_cm"), 100) - num(shelf.get("used_width_cm"), 0)

        if remaining_width < width(p):
            last_reason = "early_capacity_reject"
            continue

        aid = clean_text(aisle.get("aisle_id"))
        groups = aisle_groups.get(aid, set())

        ok, reason = can_place(p, aisle, module, shelf, groups)

        if not ok:
            last_reason = reason
            continue

        sc = placement_score(
            p,
            aisle,
            module,
            shelf,
            scoring_config,
            brand_side_rules,
        )

        if sc > best_score:
            best_score = sc
            best = item

    if not best:
        return False, None, last_reason

    aisle, module, shelf = best["aisle"], best["module"], best["shelf"]

    placed, u, f = _build_placed_record(p, aisle, module, shelf, score=best_score)
    if placed is None:
        return False, None, "capacity_not_fit"

    _commit_placed(placed, p, aisle, module, shelf, u, f, aisle_groups)

    return True, placed, "ok"

