def front_stock_qty(p: Dict[str, Any]) -> Optional[float]:
    """Satilabilir/on raf stogu. Bilinmiyorsa None."""
    for kk in ["sellable_qty", "available_qty", "front_stock_qty", "salable_qty", "satilabilir_stok"]:
        v = get(p, [kk], None)
        if v not in (None, "", "null"):
            return num(v, 0)
    return None


def reserve_stock_qty(p: Dict[str, Any]) -> Optional[float]:
    """Approval/FIRE/reserve back-stock miktari. Bilinmiyorsa None."""
    for kk in ["reserve_qty", "approval_qty", "fire_qty", "backstock_qty", "rezerv_stok"]:
        v = get(p, [kk], None)
        if v not in (None, "", "null"):
            return num(v, 0)
    return None


def has_positive_stock_signal(p: Dict[str, Any]) -> bool:
    """Satis, on_hand, sellable veya available stok pozitifse urun yerlestirmeye uygundur."""
    if sales_7d(p) > 0:
        return True
    if on_hand(p) > 0:
        return True
    fs = front_stock_qty(p)
    if fs is not None and fs > 0:
        return True
    if percent_stops(p) > 0:
        return True
    return False


