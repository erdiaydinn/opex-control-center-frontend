def storage_type(p: Dict[str, Any]) -> str:
    """Return the HARD storage class used by the optimizer.

    Rule order:
    1) storage_raw is primary physical truth: Raf/Dolap/Donuk
    2) storage_type is used only when storage_raw is empty/0/x/unknown
    3) category/name inference is last fallback
    """
    raw_storage = storage_from_raw(p)
    if raw_storage:
        return raw_storage

    explicit = key(get(p, ["storage_type", "Storage Type", "Storage", "storage"], ""))
    explicit = explicit.replace(" ", "_")

    if explicit in ["AMBIENT", "CHILLED", "FROZEN", "PALLET"]:
        return explicit

    raw = key(
        f"{product_name(p)} "
        f"{category_l1(p)} "
        f"{category_l2(p)}"
    )

    if any(x in raw for x in ["FROZEN", "DONUK", "-18", "DONDUR", "ICE CREAM", "FREEZER", "ALGIDA"]):
        return "FROZEN"

    if any(x in raw for x in ["CHILLED", "COLD", "+4", "SÃœT", "SUT", "DAIRY", "YOÄURT", "YOGURT", "FRIDGE", "DOLAP", "SOÄUK", "SOGUK"]):
        return "CHILLED"

    return "AMBIENT"


