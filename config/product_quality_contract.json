{
  "contract_version": 3,
  "brand": "EAY",
  "release_policy": {
    "repository_ready_is_not_production_ready": true,
    "field_evidence_required_for_market_leading_claim": true,
    "critical_flow_may_not_depend_on_placeholder_or_demo_data": true,
    "frontend_may_not_duplicate_authoritative_backend_or_kpi_truth": true,
    "accessibility_is_a_platform_requirement_not_an_optional_theme": true,
    "accessibility_preferences_must_not_require_disability_or_health_diagnosis": true,
    "global_product_quality_gate_required_for_all_product_surfaces": true,
    "product_surface_may_not_claim_release_eligible_with_untracked_ui_states": true,
    "repository_quality_evidence_is_not_field_or_production_acceptance": true
  },
  "global_dimensions": [
    "functional_correctness",
    "security_and_scope",
    "data_integrity",
    "task_usability",
    "visual_quality",
    "accessibility",
    "performance",
    "resilience_and_offline",
    "localization",
    "audit_and_explainability"
  ],
  "global_acceptance_targets": {
    "web_accessibility": "WCAG_2_2_AA",
    "accessibility_enhancements_beyond_minimum": [
      "screen_reader_semantics",
      "keyboard_only_operation",
      "visible_focus",
      "forced_colors_support",
      "reduced_motion",
      "no_color_only_meaning",
      "text_scaling_without_loss",
      "large_touch_targets",
      "visual_equivalent_for_audio_alerts",
      "captions_by_default_when_available",
      "transcript_support",
      "audio_description_support",
      "descriptive_transcript_support",
      "non_drag_alternative_for_drag_interactions",
      "plain_language_and_focus_mode_support"
    ],
    "supported_locales": ["tr", "en", "de", "ar", "fr", "es", "it", "nl", "pl", "pt-BR"],
    "rtl_locales": ["ar"],
    "required_user_states": ["loading", "error", "empty", "offline", "retry"],
    "localized_system_states": true,
    "rtl_requires_document_direction": true,
    "text_scaling_without_loss_percent": 200,
    "mobile_terminal_min_touch_target_dp": 48,
    "critical_task_success_rate_percent": 98,
    "usability_sus_target": 85,
    "crash_free_sessions_percent": 99.8,
    "terminal_local_scan_feedback_p95_ms": 150,
    "terminal_cold_start_p95_seconds": 2.5,
    "destructive_actions_require_explicit_confirmation": true,
    "all_mutations_require_recoverable_error_state": true,
    "offline_mutations_require_idempotent_replay": true
  },
  "inclusive_experience": {
    "visual": [
      "screen_reader_structure",
      "accessible_names_and_descriptions",
      "high_contrast",
      "forced_colors",
      "scalable_text",
      "audio_description_for_visual_media",
