EAY_AI_DB_PATH=./data/eay_ai.db
EAY_OLLAMA_URL=http://localhost:11434
EAY_MODEL=eay-ops:0.1
EAY_TEACHER_MODEL=
EAY_TOP_K=8
EAY_LOW_CONFIDENCE_THRESHOLD=0.62

# Grounded retrieval truth boundary. In production, company/operational retrieval
# remains fail-closed until canonical Core tenant authority is bound into the
# retrieval store/query. Legal/standard global retrieval remains available.
EAY_ENVIRONMENT=development

# Voice defaults fail closed: production WebSocket sessions require an exact approved
# multilingual release decision + runtime attestation bundle. Use evaluation or
# development only in explicitly non-production local environments.
EAY_VOICE_RUNTIME_MODE=production

# BigQuery remains disabled unless a trusted deployment explicitly enables it.
EAY_BQ_EXECUTION_ENABLED=false
EAY_BQ_PROJECT=
EAY_BQ_LOCATION=EU
EAY_BQ_MAX_BYTES=262144000
EAY_BQ_TIMEOUT_MS=20000

# Model production promotion is disabled unless BOTH values are provisioned by the
# trusted deployment. Never commit a real token. The token must be at least 32 chars.
# The POST /v1/model-promotions endpoint derives approved_by from the operator ID;
# callers cannot supply or impersonate the release-approver identity in the request.
EAY_MODEL_PROMOTION_OPERATOR_ID=
EAY_MODEL_PROMOTION_API_TOKEN=