EAY_AI_DB_PATH=./data/eay_ai.db
EAY_OLLAMA_URL=http://localhost:11434
EAY_MODEL=eay-ops:0.1
EAY_TEACHER_MODEL=
EAY_TOP_K=8
EAY_LOW_CONFIDENCE_THRESHOLD=0.62

# Voice defaults fail closed: production WebSocket sessions require an exact approved
# multilingual release decision + runtime attestation bundle. Use evaluation or
# development only in explicitly non-production local environments.
EAY_VOICE_RUNTIME_MODE=production

# BigQuery remains disabled unless a trusted deployment explicitly enables it.
EAY_BQ_EXECUTION_ENABLED=false
EAY_BQ_PROJECT=
EAY_BQ_LOCATION=EU
EAY_BQ_MAX_BYTES=262144000
EAY_BQ_TIMEOUT_MS=20000

# Jarvis machine identity. The private key path must point to a runtime secret,
# never a repository file. AI Core signs only short-lived tool-execution assertions.
EAY_JARVIS_SERVICE_PRIVATE_KEY_FILE=
EAY_JARVIS_SERVICE_SIGNING_KID=
EAY_JARVIS_SERVICE_ISSUER=eay-ai-core
EAY_JARVIS_SERVICE_AUDIENCE=opex-core-jarvis
EAY_JARVIS_SERVICE_LIFETIME_SECONDS=30

# Platform Core authorization transport. In Compose this stays on the internal
# ai_plane and must not use the public gateway /api/internal path.
EAY_PLATFORM_CORE_BASE_URL=http://core-api:8000
EAY_PLATFORM_CORE_AUTH_TIMEOUT_SECONDS=5

# Host/orchestrator source for the Docker secret. Keep the secret outside Git.
EAY_JARVIS_SERVICE_PRIVATE_KEY_SOURCE_FILE=
